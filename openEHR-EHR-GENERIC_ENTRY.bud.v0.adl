definition
	GENERIC_ENTRY[at0000] matches {    -- BUD
		data matches {
			ITEM_TREE[at0001] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					CLUSTER[at0002] occurrences matches {0..1} matches {    -- Inskrivning
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0003] occurrences matches {0..1} matches {    -- Olycksplats
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0004,    -- Övrigt
											at0005,    -- Inomhus hemmet
											at0006,    -- Inomhus privat
											at0007,    -- Inomhus annan byggnad
											at0008,    -- Utomhus
											at0009]    -- Trafiken
										}
									}
								}
							}
							ELEMENT[at0010] occurrences matches {0..1} matches {    -- Olycksorsak
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0011,    -- Övrigt
											at0012,    -- Olycka arbete
											at0013,    -- Olycka fritid
											at0014,    -- Suicidförsök
											at0015,    -- Mordförsök
											at0016]    -- Misshandel
										}
									}
								}
							}
							ELEMENT[at0019] occurrences matches {0..1} matches {    -- Inregistreringsdatum
								value matches {
									DV_DATE matches {*}
								}
							}
							ELEMENT[at0018] occurrences matches {0..1} matches {    -- Signatur
								value matches {
									DV_CODED_TEXT matches {*}
								}
							}
							ELEMENT[at0020] occurrences matches {0..1} matches {    -- Cirkumferent skada
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0024,    -- Ja
											at0025]    -- Nej
										}
									}
								}
							}
							ELEMENT[at0021] occurrences matches {0..1} matches {    -- Skada över stor led
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0022,    -- Ja
											at0023]    -- Nej
										}
									}
								}
							}
							ELEMENT[at0026] occurrences matches {0..1} matches {    -- Förekomst av annat trauma
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0027,    -- Ja
											at0028]    -- Nej
										}
									}
								}
							}
							ELEMENT[at0029] occurrences matches {0..1} matches {    -- Komplicerad/särskilda behov
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0030,    -- Nej
											at0031]    -- Ja
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

