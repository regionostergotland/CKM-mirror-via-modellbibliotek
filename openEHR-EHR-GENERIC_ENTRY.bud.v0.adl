				["at0034"] = <
					text = <"0">
					description = <"">
				>
				["at0035"] = <
					text = <"1">
					description = <"Daglig reg ×1–2 av temp, dryck, urin och energimätning">
				>
				["at0036"] = <
					text = <"2">
					description = <"Kontinuerlig övervakning av patient: ex suicidrisk, barnpatient, konfusionstillstånd">
				>
				["at0037"] = <
					text = <"3">
					description = <"Kontinuerlig övervakning av EKG, HF, SaO₂, ABP, ETC0₂ samt kontroller ×24 av diures, temp och andning. Deltracmätning">
				>
				["at0038"] = <
					text = <"4">
					description = <"Utöver 3 p: övrig tryckmätning, kontinuerlig CVP-mätning och ETC0₂-mätning krävs p g a patientens tillstånd">
				>
				["at0039"] = <
					text = <"Respiration">
					description = <"">
				>
				["at0040"] = <
					text = <"0">
					description = <"">
				>
				["at0041"] = <
					text = <"1">
					description = <"BRIVA-patient som post-op övervakas på postop-avdelningen">
				>
				["at0042"] = <
					text = <"2">
					description = <"Spontanandning som övervakas (ex post-op), syrgas, stöd, andningsvård, inhalation av läkemedel">
				>
				["at0043"] = <
					text = <"3">
					description = <"Okomplicerad respiratorbehandling: inställning ändras <5 ggr/dygn">
				>
				["at0044"] = <
					text = <"4">
					description = <"Komplicerad respiratorbehandling: inställning ändras >4 ggr/dygn. Hotande andningsinsufficiens. Urträning med resp.behov >12 h/dygn">
				>
				["at0045"] = <
					text = <"Cirkulation">
					description = <"">
				>
				["at0046"] = <
					text = <"0">
					description = <"">
				>
				["at0047"] = <
					text = <"1">
					description = <"">
				>
				["at0048"] = <
					text = <"2">
					description = <"Behandlas med vasoaktiv drog inom 48 tim. Riskpatient för cirkulationssvikt, störtblödning, arytmier">
				>
				["at0049"] = <
					text = <"3">
					description = <"Cirkulationssvikt: 1 vasoaktiv drog">
				>
				["at0050"] = <
					text = <"4">
					description = <"Cirkulationssvikt: >1 vasoaktiv drog">
				>
				["at0051"] = <
					text = <"Sårvård/behandling">
					description = <"">
				>
				["at0052"] = <
					text = <"0">
					description = <"">
				>
				["at0053"] = <
					text = <"1">
					description = <"Omläggning ×1 av litet sår. Förstärkning av förband">
				>
				["at0054"] = <
					text = <"2">
					description = <"Handbad. Omläggning >1/dygn. Dusch/oml <1 timme">
				>
				["at0055"] = <
					text = <"3">
					description = <"Sårrevision/omläggning utan narkos, ex PCA-pump. Anläggning av bandage. Bad i fiolen + omläggning. Dusch >1 timme">
				>
				["at0056"] = <
					text = <"4">
					description = <"Sårrevision eller omläggning under narkos">
				>
				["at0057"] = <
					text = <"Bäddning/Mob">
					description = <"">
				>
				["at0058"] = <
					text = <"0">
					description = <"Ej valbar då inneliggande patient alltid har en säng">
				>
				["at0059"] = <
					text = <"1">
					description = <"Inneliggande på BRIVA. BRIVA-patient som ligger på IVA">
				>
				["at0060"] = <
					text = <"2">
					description = <"Kräver 2 personer. ADL-hjälp upp till rullstol el. gåbord">
				>
				["at0061"] = <
					text = <"3">
					description = <"Samma, kräver 3–4 personer. Tippbräda. Sitta på sängkant">
				>
				["at0062"] = <
					text = <"4">
					description = <"Vändning, bäddning, lagring, mobilisering. Kräver ≥5 personer">
				>
				["at0063"] = <
					text = <"Provtagning">
					description = <"">
				>
				["at0064"] = <
					text = <"0">
					description = <"">
				>
				["at0065"] = <
					text = <"1">
					description = <"Blodprover 1–10 rör/dygn, ej akutsvar">
				>
				["at0066"] = <
					text = <"2">
					description = <"Blodprover 1–10 rör/dygn med akutsvar">
				>
				["at0067"] = <
					text = <"3">
					description = <"Blodprover 10–20 rör/dygn">
				>
				["at0068"] = <
