				["at0071"] = <
					text = <"1">
					description = <"Perifer nål med 1 antibiotikaprep. Tromboprofylax s.c. Intramuskulär injektion">
				>
				["at0072"] = <
					text = <"2">
					description = <"Har CVK. Perifer nål med infusioner. 1–2 antibiotikaprep. PCA-pump">
				>
				["at0073"] = <
					text = <"3">
					description = <"Normal BRIVA-TPN + vätska (Vamin, Intralipid, Glukos), 2 antibiotikaprep, 1–3 inj.prep, analgetika/lokalanestetika i sprutpump, 1–5 blodpr">
				>
