					description = <"">
				>
				["at0041"] = <
					text = <"1">
					description = <"BRIVA-patient som post-op övervakas på postop-avdelningen">
				>
				["at0042"] = <
					text = <"2">
					description = <"Spontanandning som övervakas (ex post-op), syrgas, stöd, andningsvård, inhalation av läkemedel">
				>
				["at0043"] = <
					text = <"3">
					description = <"Okomplicerad respiratorbehandling: inställning ändras <5 ggr/dygn">
				>
				["at0044"] = <
					text = <"4">
					description = <"Komplicerad respiratorbehandling: inställning ändras >4 ggr/dygn. Hotande andningsinsufficiens. Urträning med resp.behov >12 h/dygn">
				>
