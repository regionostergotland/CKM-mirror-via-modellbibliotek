definition
	CLUSTER[at0000] matches {    -- imaging_exam_us-technique
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Mode
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0004,    -- 2D
							at0005,    -- 3D
							at0006,    -- M-mode
							at0007]    -- Doppler
						}
					}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- View
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0008,    -- PLAX
							at0009,    -- PSAX
							at0012,    -- 4 Chamber
							at0013]    -- 2 Chamber
						}
					}
				}
			}
			ELEMENT[at0003] occurrences matches {0..1} matches {    -- Method
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0010,    -- Biplane
							at0011]    -- Single plane
						}
					}
				}
			}
		}
	}

