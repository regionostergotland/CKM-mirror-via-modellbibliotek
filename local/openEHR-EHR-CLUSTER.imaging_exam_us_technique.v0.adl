definition
	CLUSTER[at0000] matches {    -- Imaging examination ultrasound techniques
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..*} matches {    -- View
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0020,    -- PLAX
							at0021,    -- 2 chamber
							at0022,    -- 3 chamber
							at0023,    -- 4 chamber
							at0024,    -- 5 chamber
							at0033]    -- PSAX
						}
					}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- 2D Method
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0007,    -- Single plane
							at0008,    -- Biplane
							at0009]    -- Triplane
						}
					}
				}
			}
			ELEMENT[at0025] occurrences matches {0..1} matches {    -- Doppler Method
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0026,    -- Continuous wave doppler
							at0027,    -- Pulsed wave doppler
							at0028]    -- Tissue doppler
						}
					}
				}
			}
			ELEMENT[at0003] occurrences matches {0..*} matches {    -- Mode
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0010,    -- M-mode
							at0011,    -- 2D
							at0012,    -- 3D
							at0013,    -- Doppler
							at0014]    -- Speckle tracking
						}
					}
				}
			}
			ELEMENT[at0006] occurrences matches {0..1} matches {    -- Area algorithm
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::at0019]    -- Continuity equation
						}
					}
				}
			}
			ELEMENT[at0005] occurrences matches {0..1} matches {    -- Mass algorithm
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::at0017]    -- Devereux method
						}
					}
				}
			}
			ELEMENT[at0030] occurrences matches {0..1} matches {    -- Pressure algorithm
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::at0032]    -- sPAP = TR Vmax^2 * 4 + RAP
						}
					}
				}
			}
			ELEMENT[at0004] occurrences matches {0..1} matches {    -- Volume algorithm
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0015,    -- Simpson's method
							at0016]    -- Teichholz method
						}
					}
				}
			}
		}
	}

