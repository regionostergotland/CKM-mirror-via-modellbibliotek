archetype (adl_version=1.4; uid=2ec9c071-ddac-42da-a27a-202255d9e4b0)
	openEHR-EHR-CLUSTER.imaging_exam_us_technique.v0

concept
	[at0000]

language
	original_language = <[ISO_639-1::en]>

description
	original_author = <
		["date"] = <"2025-11-05">
	>
	lifecycle_state = <"unmanaged">
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record the technique used on an ultrasound examination.">
			keywords = <"technique, ultrasound, imaging, image, radiology", ...>
			use = <"Use to record the technique used on an ultrasound examination.

This archetype is designed to be nested within the 'Structured technique/procedure' SLOT in the OBSERVATION.imaging_exam_result or within other relevant CLUSTER.imaging_exam archetypes, but can also be used within other ENTRY or CLUSTER archetypes, where clinically appropriate.">
			misuse = <"Not to be used to record details related to the overall findings or context related to a ultrasound examination. Use the OBSERVATION.imaging_exam_result for this purpose. For example, comments on the study quality, differential diagnoses, and overall impression.">
		>
	>
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["custodian_organisation"] = <"openEHR Foundation">
		["original_namespace"] = <"org.openehr">
		["original_publisher"] = <"openEHR Foundation">
		["custodian_namespace"] = <"org.openehr">
		["MD5-CAM-1.0.1"] = <"c8a111d722a79ae566404259b2743c39">
		["build_uid"] = <"0a87d244-c7aa-3381-ac03-e2ed322a35b1">
	>

definition
	CLUSTER[at0000] matches {    -- Imaging examination ultrasound techniques
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..*} matches {    -- View
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0020,    -- PLAX
							at0021,    -- 2 chamber
							at0022,    -- 3 chamber
							at0023,    -- 4 chamber
							at0024,    -- 5 chamber
							at0033]    -- PSAX
						}
					}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- 2D Method
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0007,    -- Single plane
							at0008,    -- Biplane
							at0009]    -- Triplane
						}
					}
				}
			}
			ELEMENT[at0025] occurrences matches {0..1} matches {    -- Doppler Method
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0026,    -- Continuous wave doppler
							at0027,    -- Pulsed wave doppler
							at0028]    -- Tissue doppler
						}
					}
				}
			}
			ELEMENT[at0003] occurrences matches {0..*} matches {    -- Mode
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0010,    -- M-mode
							at0011,    -- 2D
							at0012,    -- 3D
							at0013,    -- Doppler
							at0014]    -- Speckle tracking
						}
					}
				}
			}
			ELEMENT[at0034] occurrences matches {0..1} matches {    -- Algorithm
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0035,    -- Continuity equation
							at0036,    -- Devereux method
							at0037,    -- Simpson's method
							at0038,    -- Teichholz method
							at0039]    -- sPAP = TR Vmax^2 * 4 + RAP
						}
					}
				}
			}
		}
	}

