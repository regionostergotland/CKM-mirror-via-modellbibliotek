definition
	CLUSTER[at0000] matches {    -- imaging_exam_us_technique
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- View
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- Method
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0007,    -- Single plane
							at0008,    -- Biplane
							at0009]    -- Triplane
						}
					}
				}
			}
			ELEMENT[at0003] occurrences matches {0..1} matches {    -- Mode
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0010,    -- M-mode
							at0011,    -- 2D
							at0012,    -- 3D
							at0013,    -- Doppler
							at0014]    -- Speckle tracking
						}
					}
				}
			}
			ELEMENT[at0004] occurrences matches {0..1} matches {    -- Volume algorithm
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0015,    -- Simpson's method
							at0016]    -- Teichholz method
						}
					}
				}
			}
			ELEMENT[at0005] occurrences matches {0..1} matches {    -- Mass algorithm
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0017,    -- Devereux method
							at0018]    -- Linear cube formula
						}
					}
				}
			}
			ELEMENT[at0006] occurrences matches {0..1} matches {    -- Area algorithm
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::at0019]    -- Continuity equation of VTI
						}
					}
				}
			}
		}
	}

