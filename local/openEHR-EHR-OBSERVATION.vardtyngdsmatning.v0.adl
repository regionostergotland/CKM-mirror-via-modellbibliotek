					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Any event">
					description = <"@ internal @">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0006"] = <
					text = <"Surveillance">
					description = <"">
				>
				["at0008"] = <
					text = <"Daily control">
					description = <"Daily control (x2): temperature, fluids, urine output and energy intake">
				>
				["at0009"] = <
					text = <"Continuous sureveillance">
					description = <"Continuous sureveillance due to: confusion or suicide risk or being a child">
				>
				["at0010"] = <
					text = <"Continuous monitoring">
					description = <"Continuous monitoring: ECG, HR, SaO2, MAP. Every hour: urine output, temperature or metabolic monitoring.">
				>
			>
		>
	>
